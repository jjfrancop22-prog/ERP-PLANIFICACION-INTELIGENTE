rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function userPath(){return /databases/$(database)/documents/users/$(request.auth.uid);}
  function active(){return signedIn() && exists(userPath()) && get(userPath()).data.active == true;}
  function manager(){return active() && get(userPath()).data.role in ['ADMIN','CALIDAD'];}
  function allowedRecord(){return request.resource.data.keys().hasOnly(['title','requirementId','createdAt','createdBy','status']) && request.resource.data.keys().hasAll(['title','requirementId','createdAt','createdBy','status']) && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 240 && request.resource.data.requirementId is string && request.resource.data.requirementId.size() <= 12 && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time && request.resource.data.status == 'DRAFT';}
  match /users/{uid}{allow get:if signedIn() && (request.auth.uid==uid || manager());allow list:if manager();allow create,update,delete:if false;}
  // V1.1.18: evaluaciones retiradas del ERP. Histórico protegido y sin nuevas escrituras.
  match /sgcRequirementEvaluations/{id}{
   allow get,list: if manager();
   allow create,update,delete: if false;
  }
  match /sgcConsultants/{id}{
   allow get,list: if active();
   allow create: if manager() && request.resource.data.keys().hasOnly(['name','identity','position','organization','active','createdBy','createdAt','updatedBy','updatedAt']) && request.resource.data.createdBy==request.auth.uid && request.resource.data.createdAt==request.time && request.resource.data.updatedBy==request.auth.uid && request.resource.data.updatedAt==request.time && request.resource.data.active is bool && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=160 && request.resource.data.identity is string && request.resource.data.identity.size()>0 && request.resource.data.identity.size()<=35 && request.resource.data.position is string && request.resource.data.position.size()>0 && request.resource.data.position.size()<=120 && request.resource.data.organization is string && request.resource.data.organization.size()>0 && request.resource.data.organization.size()<=160;
   allow update: if manager() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','identity','position','organization','active','updatedBy','updatedAt']) && request.resource.data.updatedBy==request.auth.uid && request.resource.data.updatedAt==request.time;
   allow delete: if false;
  }
  match /sgcConsultantDeclarations/{id}{
   allow get,list: if active();
   allow create: if manager() && request.resource.data.keys().hasOnly(['personId','personName','identity','position','organization','formatCode','formatVersion','conflict','detail','accepted','identityMatched','reviewStatus','createdAt','createdBy']) && request.resource.data.createdBy==request.auth.uid && request.resource.data.createdAt==request.time && request.resource.data.formatCode=='PSI-MC0205' && request.resource.data.formatVersion=='03' && request.resource.data.accepted==true && request.resource.data.identityMatched==true && request.resource.data.conflict in ['SI','NO'] && request.resource.data.personId is string && request.resource.data.personName is string && request.resource.data.detail is string && request.resource.data.detail.size()<=800;
   allow update,delete: if false;
  }
  match /sgcPersonnel/{id}{
   allow get,list: if active();
   allow create: if manager() && request.resource.data.keys().hasOnly(['name','identity','position','area','organization','linkType','contract','joined','left','active','mc0201','mc0203','createdAt','createdBy','updatedAt','updatedBy','functions','connections']) && request.resource.data.createdBy==request.auth.uid && request.resource.data.updatedBy==request.auth.uid && request.resource.data.createdAt==request.time && request.resource.data.updatedAt==request.time && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=160 && request.resource.data.position is string && request.resource.data.area is string && request.resource.data.functions is list && request.resource.data.connections is list;
   allow update: if manager() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','identity','position','area','organization','linkType','contract','joined','left','active','mc0201','mc0203','updatedAt','updatedBy','functions','connections']) && request.resource.data.updatedBy==request.auth.uid && request.resource.data.updatedAt==request.time && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=160 && request.resource.data.functions is list && request.resource.data.connections is list;
   allow delete: if false;
  }
  match /sgcPersonnelLinks/{id}{
   allow get,list: if active();
   allow create: if manager() && request.resource.data.keys().hasOnly(['personId','personName','personPosition','targetType','targetId','targetKey','targetLabel','requirementId','role','active','createdBy','createdAt','updatedBy','updatedAt']) && request.resource.data.keys().hasAll(['personId','personName','personPosition','targetType','targetId','targetKey','targetLabel','requirementId','role','active','createdBy','createdAt','updatedBy','updatedAt']) && request.resource.data.personId is string && request.resource.data.personId.size()>0 && request.resource.data.targetId is string && request.resource.data.targetId.size()>0 && request.resource.data.targetType in ['LIBRARY','REQUIREMENT'] && request.resource.data.targetKey == request.resource.data.targetType + ':' + request.resource.data.targetId && request.resource.data.personName is string && request.resource.data.personName.size()<=160 && request.resource.data.targetLabel is string && request.resource.data.targetLabel.size()<=240 && request.resource.data.role in ['RESPONSABLE','ELABORADOR','REVISOR','APROBADOR','RESPONSABLE DE ACTIVIDAD','RESPONSABLE DE EVIDENCIA','PRINCIPAL','CORRESPONSABLE','RECURSOS','DETECCION','ACCIONES','INFORMACION','SEGUIMIENTO','EFICACIA_TECNICA'] && request.resource.data.active==true && request.resource.data.createdBy==request.auth.uid && request.resource.data.updatedBy==request.auth.uid && request.resource.data.createdAt==request.time && request.resource.data.updatedAt==request.time;
   allow update: if manager() && resource.data.active==true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','updatedBy','updatedAt']) && request.resource.data.active==false && request.resource.data.updatedBy==request.auth.uid && request.resource.data.updatedAt==request.time;
   allow delete: if false;
  }
  match /dashboards/{id}{allow get:if active() && id=='global';allow list,write:if false;}
  match /notifications/{id}{allow get,list:if active() && resource.data.recipientId==request.auth.uid;allow update:if active() && resource.data.recipientId==request.auth.uid && resource.data.status=='OPEN' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolvedAt','resolvedBy']) && request.resource.data.status=='RESOLVED' && request.resource.data.resolvedBy==request.auth.uid && request.resource.data.resolvedAt==request.time;allow create:if active()
    && request.resource.data.keys().hasOnly(['recipientId','createdBy','eventKey','title','message','requirementId','status','createdAt'])
    && request.resource.data.keys().hasAll(['recipientId','createdBy','eventKey','title','message','requirementId','status','createdAt'])
    && request.resource.data.recipientId == request.auth.uid
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.eventKey is string
    && request.resource.data.eventKey.size() > 0 && request.resource.data.eventKey.size() <= 110
    && id == request.auth.uid + '_' + request.resource.data.eventKey
    && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 160
    && request.resource.data.message is string && request.resource.data.message.size() <= 500
    && request.resource.data.requirementId is string && request.resource.data.requirementId.size() <= 12
    && request.resource.data.status == 'OPEN'
    && request.resource.data.createdAt == request.time;
   allow delete:if false;}
  match /sgcDocuments/{id}{allow get,list:if active();allow create:if manager() && request.resource.data.keys().hasOnly(['title','requirementId','createdAt','createdBy','status','code','version','responsible','description']) && request.resource.data.keys().hasAll(['title','requirementId','createdAt','createdBy','status','code','version','responsible','description']) && request.resource.data.title is string && request.resource.data.title.size()>0 && request.resource.data.title.size()<=240 && request.resource.data.requirementId is string && request.resource.data.requirementId.size()<=12 && request.resource.data.createdBy==request.auth.uid && request.resource.data.createdAt==request.time && request.resource.data.status=='DRAFT' && request.resource.data.code is string && request.resource.data.code.size()>0 && request.resource.data.code.size()<=40 && request.resource.data.version is string && request.resource.data.version.size()>0 && request.resource.data.version.size()<=20 && request.resource.data.responsible is string && request.resource.data.responsible.size()>0 && request.resource.data.responsible.size()<=120 && request.resource.data.description is string && request.resource.data.description.size()<=500;allow update:if manager()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','code','version','responsible','description','status','updatedAt','updatedBy','decisionNote'])
    && request.resource.data.updatedBy == request.auth.uid
    && request.resource.data.updatedAt == request.time
    && ((resource.data.status == 'DRAFT' && request.resource.data.status == 'DRAFT'
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','code','version','responsible','description','updatedAt','updatedBy'])
         && request.resource.data.title is string && request.resource.data.title.size()>0 && request.resource.data.title.size()<=240
         && request.resource.data.code is string && request.resource.data.code.size()>0 && request.resource.data.code.size()<=40
         && request.resource.data.version is string && request.resource.data.version.size()>0 && request.resource.data.version.size()<=20
         && request.resource.data.responsible is string && request.resource.data.responsible.size()>0 && request.resource.data.responsible.size()<=120
         && request.resource.data.description is string && request.resource.data.description.size()<=500)
       || (resource.data.status == 'DRAFT' && request.resource.data.status == 'IN_REVIEW'
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','updatedBy','decisionNote'])
           && request.resource.data.decisionNote is string && request.resource.data.decisionNote.size()<=500)
       || (resource.data.status == 'IN_REVIEW' && request.resource.data.status == 'DRAFT'
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','updatedBy','decisionNote'])
           && request.resource.data.decisionNote is string && request.resource.data.decisionNote.size()<=500)
       || (resource.data.status == 'IN_REVIEW' && request.resource.data.status == 'APPROVED'
           && get(userPath()).data.role == 'ADMIN' && resource.data.createdBy != request.auth.uid
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','updatedBy','decisionNote'])
           && request.resource.data.decisionNote is string && request.resource.data.decisionNote.size()<=500));
   allow delete:if false;}
  // V1.1.43 — Evidencias de campo PET0103-07: registros completados separados del formato maestro.
  // Acceso restringido a ADMIN/CALIDAD por datos de clientes y muestras. PDF fragmentado en Spark.
  match /sgcFieldCustody54/{id}{
   allow get,list: if manager();
   allow create: if manager()
    && request.resource.data.keys().hasOnly(['masterCode','masterDisplayCode','masterId','masterVersion','filename','size','sha256','parts','status','sampleDate','client','sampleCode','createdAt','createdBy'])
    && request.resource.data.masterCode=='PET0103'
    && request.resource.data.masterDisplayCode=='PET0103-07'
    && request.resource.data.masterId is string && request.resource.data.masterId.size()<=120
    && request.resource.data.masterVersion is string && request.resource.data.masterVersion.size()<=20
    && request.resource.data.filename is string && request.resource.data.filename.size()>0 && request.resource.data.filename.size()<=255
    && request.resource.data.size is int && request.resource.data.size>0 && request.resource.data.size<=409600
    && request.resource.data.sha256 is string && request.resource.data.sha256.size()==64 && id==request.resource.data.sha256
    && request.resource.data.parts is int && request.resource.data.parts>0 && request.resource.data.parts<=52
    && request.resource.data.status=='UPLOADING'
    && request.resource.data.sampleDate is string && request.resource.data.sampleDate.size()==10
    && request.resource.data.client is string && request.resource.data.client.size()<=120
    && request.resource.data.sampleCode is string && request.resource.data.sampleCode.size()<=100
    && request.resource.data.createdBy==request.auth.uid && request.resource.data.createdAt==request.time;
   allow update: if manager() && resource.data.status=='UPLOADING'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','completedAt'])
    && request.resource.data.status=='READY' && request.resource.data.completedAt==request.time;
   allow delete: if false;
   match /chunks/{chunkId}{
    allow get: if manager();allow list: if false;
    allow create: if manager()
     && get(/databases/$(database)/documents/sgcFieldCustody54/$(id)).data.status=='UPLOADING'
     && request.resource.data.keys().hasOnly(['data','index'])
     && request.resource.data.data is string && request.resource.data.data.size()<=16000
     && request.resource.data.index is int && request.resource.data.index>=0 && request.resource.data.index<52;
    allow update,delete: if false;
   }
  }
  // V1.1.50 — Actas PG0204-04: registros individuales independientes de la plantilla.
  // V1.1.52 — Evaluación de difusión por edición aprobada; lectura bajo demanda.
  // V1.1.62 — Evaluación preliminar por edición aprobada; una sola evaluación por edición.
  match /sgcChangeScreenings57b/{id}{
   allow get,list: if manager();
   allow create: if manager()
    && request.resource.data.keys().hasOnly(['documentId','documentCode','documentTitle','documentVersion','impact','reason','status','createdBy','createdAt'])
    && request.resource.data.documentId is string && request.resource.data.documentId.size()>0 && request.resource.data.documentId.size()<=180
    && request.resource.data.documentCode is string && request.resource.data.documentCode.size()<=60
    && request.resource.data.documentTitle is string && request.resource.data.documentTitle.size()<=240
    && request.resource.data.documentVersion is string && request.resource.data.documentVersion.size()>0 && request.resource.data.documentVersion.size()<=30
    && id == 'doc_' + request.resource.data.documentId + '_' + request.resource.data.documentVersion
    && exists(/databases/$(database)/documents/sgcLibrary/$(request.resource.data.documentId))
    && get(/databases/$(database)/documents/sgcLibrary/$(request.resource.data.documentId)).data.approvalStatus == 'APPROVED'
    && get(/databases/$(database)/documents/sgcLibrary/$(request.resource.data.documentId)).data.version == request.resource.data.documentVersion
    && request.resource.data.impact is bool
    && request.resource.data.status == (request.resource.data.impact == true ? 'REQUIERE_GESTION' : 'SIN_GESTION_ADICIONAL')
    && request.resource.data.reason is string && request.resource.data.reason.size()>=12 && request.resource.data.reason.size()<=1800
    && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
   allow update,delete: if false;
  }
  // V1.1.61 — Expedientes 5.7 b): creación única y transiciones controladas.
  match /sgcChanges57b/{id}{
   allow get,list: if manager();
   allow create: if manager()
    && request.resource.data.keys().hasOnly(['title','kind','description','impact','risk','actions','owner','deadline','authority','authorityBasis','verification','status','createdBy','createdAt','updatedBy','updatedAt'])
    && request.resource.data.title is string && request.resource.data.title.size()>0 && request.resource.data.title.size()<=180
    && request.resource.data.kind in ['DOCUMENTAL','PERSONAL','TECNICO','OTRO']
    && request.resource.data.description is string && request.resource.data.description.size()>0 && request.resource.data.description.size()<=1800
    && request.resource.data.impact is string && request.resource.data.impact.size()>0 && request.resource.data.impact.size()<=1800
    && request.resource.data.risk is string && request.resource.data.risk.size()<=1800
    && request.resource.data.actions is string && request.resource.data.actions.size()<=1800
    && request.resource.data.verification is string && request.resource.data.verification.size()<=1800
    && request.resource.data.owner is string && request.resource.data.owner.size()>0 && request.resource.data.owner.size()<=160
    && request.resource.data.deadline is string && request.resource.data.deadline.size()<=10
    && request.resource.data.authority is string && request.resource.data.authority.size()<=160
    && request.resource.data.authorityBasis is string && request.resource.data.authorityBasis.size()<=240
    && request.resource.data.status=='EVALUACION'
    && request.resource.data.createdBy==request.auth.uid && request.resource.data.updatedBy==request.auth.uid
    && request.resource.data.createdAt==request.time && request.resource.data.updatedAt==request.time;
   allow update: if manager()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','decisionNote','updatedBy','updatedAt','authorizedBy','authorizedAt','closedBy','closedAt'])
    && request.resource.data.decisionNote is string && request.resource.data.decisionNote.size()>=12 && request.resource.data.decisionNote.size()<=1800
    && request.resource.data.updatedBy==request.auth.uid && request.resource.data.updatedAt==request.time
    && ((resource.data.status in ['EVALUACION','DEVUELTO'] && request.resource.data.status in ['DEVUELTO','AUTORIZADO','RECHAZADO']
         && (request.resource.data.status=='DEVUELTO' || get(userPath()).data.role=='ADMIN')
         && (request.resource.data.status!='AUTORIZADO' || (
            resource.data.authority is string && resource.data.authority.size()>0
            && resource.data.authorityBasis is string && resource.data.authorityBasis.size()>0
            && request.resource.data.authorizedBy==request.auth.uid && request.resource.data.authorizedAt==request.time)))
      || (resource.data.status=='AUTORIZADO' && request.resource.data.status=='IMPLEMENTADO')
      || (resource.data.status=='IMPLEMENTADO' && request.resource.data.status=='CERRADO'
          && request.resource.data.closedBy==request.auth.uid && request.resource.data.closedAt==request.time));
   allow delete: if false;
  }
  match /sgcDiffusionAssessments/{id}{
   allow get,list: if manager();
   allow create,update: if manager()
    && request.resource.data.keys().hasOnly(['documentId','documentCode','documentTitle','documentVersion','decision','reason','assessedBy','assessedAt'])
    && request.resource.data.documentId is string && request.resource.data.documentId.size()>0 && request.resource.data.documentId.size()<=180
    && request.resource.data.documentCode is string && request.resource.data.documentCode.size()<=60
    && request.resource.data.documentTitle is string && request.resource.data.documentTitle.size()<=240
    && request.resource.data.documentVersion is string && request.resource.data.documentVersion.size()<=30
    && request.resource.data.decision in ['REQUIRED','NOT_REQUIRED']
    && request.resource.data.reason is string && request.resource.data.reason.size()>=12 && request.resource.data.reason.size()<=500
    && request.resource.data.assessedBy==request.auth.uid && request.resource.data.assessedAt==request.time
    && (!exists(/databases/$(database)/documents/sgcDiffusionAssessments/$(id)) || request.resource.data.documentId==resource.data.documentId && request.resource.data.documentVersion==resource.data.documentVersion);
   allow delete: if false;
  }
  match /sgcDiffusionsPG0204/{id}{
   allow get,list: if manager();
   allow create: if manager()
    && request.resource.data.keys().hasOnly(['formatCode','formatVersion','documentId','documentCode','documentTitle','documentVersion','topic','objective','summary','responsible','mode','date','recipients','recipientDetails','notes','status','createdBy','createdAt'])
    && request.resource.data.formatCode == 'PG0204' && request.resource.data.formatVersion == '04'
    && request.resource.data.documentId is string && request.resource.data.documentId.size()>0 && request.resource.data.documentId.size()<=180
    && request.resource.data.documentCode is string && request.resource.data.documentCode.size()<=60
    && request.resource.data.documentTitle is string && request.resource.data.documentTitle.size()<=240
    && request.resource.data.documentVersion is string && request.resource.data.documentVersion.size()<=30
    && request.resource.data.topic is string && request.resource.data.topic.size()>0 && request.resource.data.topic.size()<=240
    && request.resource.data.objective is string && request.resource.data.objective.size()>0 && request.resource.data.objective.size()<=1200
    && request.resource.data.summary is string && request.resource.data.summary.size()>0 && request.resource.data.summary.size()<=5000
    && request.resource.data.responsible is string && request.resource.data.responsible.size()>0 && request.resource.data.responsible.size()<=160
    && request.resource.data.mode in ['CORREO','PRESENCIAL','MIXTA','VERBAL','ESCRITA','REUNION','OTRO']
    && request.resource.data.date is string && request.resource.data.date.size()==10
    && request.resource.data.recipients is list && request.resource.data.recipients.size()>0 && request.resource.data.recipients.size()<=50
    && request.resource.data.recipientDetails is list
    && request.resource.data.recipientDetails.size()==request.resource.data.recipients.size()
    && request.resource.data.recipientDetails.size()<=50
    && request.resource.data.notes is string && request.resource.data.notes.size()<=1500
    && request.resource.data.status=='DRAFT' && request.resource.data.createdBy==request.auth.uid && request.resource.data.createdAt==request.time;
   allow update: if manager() && resource.data.status=='DRAFT'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','sentReference','sentBy','sentAt'])
    && request.resource.data.status=='SENT'
    && request.resource.data.sentReference is string && request.resource.data.sentReference.size()>=8 && request.resource.data.sentReference.size()<=300
    && request.resource.data.sentBy==request.auth.uid && request.resource.data.sentAt==request.time;
   allow delete: if false;
  }
  match /sgcLibrary/{id}{
   allow get,list: if active();
   allow create: if manager()
    && request.resource.data.keys().hasOnly(['code','title','version','responsible','type','classification','area','description','referenceUrl','referenceFileName','fileStored','requirementIds','status','createdBy','createdAt','updatedBy','updatedAt'])
    && request.resource.data.code is string && request.resource.data.code.size()>0 && request.resource.data.code.size()<=40
    && request.resource.data.title is string && request.resource.data.title.size()>0 && request.resource.data.title.size()<=240
    && request.resource.data.version is string && request.resource.data.version.size()>0 && request.resource.data.version.size()<=20
    && request.resource.data.responsible is string && request.resource.data.responsible.size()>0 && request.resource.data.responsible.size()<=120
    && request.resource.data.type in ['PROCEDIMIENTO','MANUAL','POLITICA','INSTRUCTIVO','FORMATO','EXTERNO','INTERNO_CONSULTA']
    && request.resource.data.classification is string && request.resource.data.classification.size()<=30
    && request.resource.data.area is string && request.resource.data.area.size()<=40
    && request.resource.data.description is string && request.resource.data.description.size()<=500
    && request.resource.data.referenceUrl is string && request.resource.data.referenceUrl.size()<=2048
    && request.resource.data.referenceFileName is string && request.resource.data.referenceFileName.size()<=255
    && request.resource.data.fileStored is bool
    && request.resource.data.requirementIds is list && request.resource.data.requirementIds.size()<=40
    && request.resource.data.status=='REGISTERED'
    && request.resource.data.createdBy==request.auth.uid && request.resource.data.updatedBy==request.auth.uid
    && request.resource.data.createdAt==request.time && request.resource.data.updatedAt==request.time;
   // Metadata-only updates; no PDF, version or approval changes.
   allow update: if manager()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type','classification','area','updatedBy','updatedAt'])
    && request.resource.data.type in ['PROCEDIMIENTO','MANUAL','POLITICA','INSTRUCTIVO','FORMATO','EXTERNO','INTERNO_CONSULTA']
    && request.resource.data.classification is string && request.resource.data.classification.size()<=30
    && request.resource.data.area is string && request.resource.data.area.size()<=40
    && request.resource.data.updatedBy==request.auth.uid && request.resource.data.updatedAt==request.time;
   allow update: if manager()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requirementIds','version','fileStored','referenceFileName','approvalStatus','activePdfId','pdfSignatureState','updatedBy','updatedAt'])
    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['approvalStatus']) || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['version','fileStored','referenceFileName']) && request.resource.data.approvalStatus == 'REGISTERED'))
    && request.resource.data.requirementIds is list && request.resource.data.requirementIds.size()<=40
    && request.resource.data.updatedBy==request.auth.uid && request.resource.data.updatedAt==request.time;
   allow update: if manager()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activePdfId','pdfSignatureState','referenceFileName','updatedBy','updatedAt'])
    && request.resource.data.activePdfId is string
    && request.resource.data.pdfSignatureState == 'SIGNED'
    && request.resource.data.referenceFileName is string
    && request.resource.data.referenceFileName.size()<=255
    && get(/databases/$(database)/documents/sgcLibrary/$(id)/versions/$(request.resource.data.activePdfId)).data.status == 'READY'
    && get(/databases/$(database)/documents/sgcLibrary/$(id)/versions/$(request.resource.data.activePdfId)).data.version == resource.data.version
    && request.resource.data.updatedBy == request.auth.uid
    && request.resource.data.updatedAt == request.time;
   allow update: if manager()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvalStatus','reviewRequestedBy','reviewRequestedAt','approvedBy','approvedAt','approvalVersion','decisionNote','updatedBy','updatedAt'])
    && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time
    && request.resource.data.decisionNote is string && request.resource.data.decisionNote.size()<=500
    && (( ( !('approvalStatus' in resource.data) || resource.data.approvalStatus in ['REGISTERED','RETURNED'])
           && request.resource.data.approvalStatus == 'IN_REVIEW'
           && request.resource.data.reviewRequestedBy == request.auth.uid
           && request.resource.data.reviewRequestedAt == request.time
           && (resource.data.fileStored == true || resource.data.code == 'PG0201'))
       || (resource.data.approvalStatus == 'IN_REVIEW'
           && get(userPath()).data.role in ['ADMIN','CALIDAD']
           && ((request.resource.data.approvalStatus == 'APPROVED'
                && request.resource.data.approvedBy == request.auth.uid
                && request.resource.data.approvedAt == request.time
                && request.resource.data.approvalVersion == resource.data.version)
             || request.resource.data.approvalStatus == 'RETURNED')));
   allow delete: if false;
   match /approvalEvents/{eventId}{
    allow get,list: if active();
    allow create: if manager()
     && request.resource.data.keys().hasOnly(['action','version','actor','at','note'])
     && request.resource.data.keys().hasAll(['action','version','actor','at','note'])
     && request.resource.data.actor == request.auth.uid
     && request.resource.data.at == request.time
     && request.resource.data.note is string && request.resource.data.note.size()<=500
     && request.resource.data.version == getAfter(/databases/$(database)/documents/sgcLibrary/$(id)).data.version
     && ((request.resource.data.action == 'REVIEW' && getAfter(/databases/$(database)/documents/sgcLibrary/$(id)).data.approvalStatus == 'IN_REVIEW' && getAfter(/databases/$(database)/documents/sgcLibrary/$(id)).data.reviewRequestedBy == request.auth.uid)
       || (request.resource.data.action == 'APPROVE' && getAfter(/databases/$(database)/documents/sgcLibrary/$(id)).data.approvalStatus == 'APPROVED' && getAfter(/databases/$(database)/documents/sgcLibrary/$(id)).data.approvedBy == request.auth.uid)
       || (request.resource.data.action == 'RETURN' && getAfter(/databases/$(database)/documents/sgcLibrary/$(id)).data.approvalStatus == 'RETURNED' && get(userPath()).data.role in ['ADMIN','CALIDAD']));
    allow update,delete: if false;
   }
  }
  match /sgcLibrary/{libraryId}/versions/{versionId}{
   allow get,list:if active();
   allow create:if manager() && request.resource.data.keys().hasOnly(['version','filename','size','sha256','parts','status','createdBy','createdAt','revisionOf','reason']) && request.resource.data.version is string && request.resource.data.version.size()>0 && request.resource.data.version.size()<=20 && request.resource.data.filename is string && request.resource.data.filename.size()<=255 && request.resource.data.size is int && request.resource.data.size>0 && request.resource.data.size<=614400 && request.resource.data.parts is int && request.resource.data.parts>0 && request.resource.data.parts<=52 && request.resource.data.sha256 is string && request.resource.data.sha256.size()==64 && request.resource.data.status=='UPLOADING' && request.resource.data.createdBy==request.auth.uid && request.resource.data.createdAt==request.time && (!('revisionOf' in request.resource.data) || (request.resource.data.revisionOf is string && request.resource.data.reason is string && request.resource.data.reason.size()<=180));
   allow update:if manager() && resource.data.status=='UPLOADING' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','completedAt']) && request.resource.data.status=='READY' && request.resource.data.completedAt==request.time;
   allow delete:if false;
   match /chunks/{chunkId}{
    allow get:if active();allow list:if false;
    allow create:if manager() && get(/databases/$(database)/documents/sgcLibrary/$(libraryId)/versions/$(versionId)).data.status=='UPLOADING' && request.resource.data.keys().hasOnly(['data','index']) && request.resource.data.data is string && request.resource.data.data.size()<=16000 && request.resource.data.index is int && request.resource.data.index>=0 && request.resource.data.index<52;
    allow update,delete:if false;
   }
  }
  // V1.0.48 — Declaraciones anuales de conflictos de interés. Acceso restringido a Calidad/Administración.
  match /sgcConflictDeclarations/{id}{
   allow get,list: if manager();
   allow create: if manager() && id == string(request.resource.data.year) + '_' + request.resource.data.personId
    && request.resource.data.keys().hasOnly(['personId','personName','year','formatCode','formatVersion','answers','accepted','reviewStatus','createdAt','createdBy','reviewedAt','reviewedBy','assessment','measures'])
    && request.resource.data.personId is string && request.resource.data.personId.size()>0
    && request.resource.data.personName is string && request.resource.data.personName.size()>0 && request.resource.data.personName.size()<=160
    && request.resource.data.year is int && request.resource.data.year>=2026 && request.resource.data.year<=2100
    && request.resource.data.formatCode=='PSI-MC0206' && request.resource.data.formatVersion=='04'
    && request.resource.data.answers is list && request.resource.data.answers.size()==5
    && request.resource.data.accepted==true && request.resource.data.reviewStatus in ['PENDIENTE_EVALUACION','SIN_SITUACIONES_DECLARADAS']
    && request.resource.data.createdAt==request.time && request.resource.data.createdBy==request.auth.uid
    && request.resource.data.reviewedAt==null && request.resource.data.reviewedBy=='' && request.resource.data.assessment=='' && request.resource.data.measures=='';
   allow update: if manager() && resource.data.reviewStatus=='PENDIENTE_EVALUACION'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewStatus','assessment','measures','reviewedAt','reviewedBy'])
    && request.resource.data.reviewStatus in ['CONTROLADO','RIESGO_SIN_CONTROLAR']
    && request.resource.data.assessment is string && request.resource.data.assessment.size()>0 && request.resource.data.assessment.size()<=1500
    && request.resource.data.measures is string && request.resource.data.measures.size()>0 && request.resource.data.measures.size()<=1500
    && request.resource.data.reviewedAt==request.time && request.resource.data.reviewedBy==request.auth.uid;
   allow delete: if false;
  }
  // V1.0.57 — Catálogo compartido para fuentes e identificadores externos/históricos.
  match /sgcRiskCatalog/{id}{
   allow get,list: if active();
   allow create: if active()
    && request.resource.data.keys().hasOnly(['type','name','position','area','createdBy','createdAt'])
    && request.resource.data.keys().hasAll(['type','name','position','area','createdBy','createdAt'])
    && request.resource.data.type in ['SOURCE','IDENTIFIER']
    && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=120
    && request.resource.data.position is string && request.resource.data.position.size()<=120
    && request.resource.data.area is string && request.resource.data.area.size()<=120
    && request.resource.data.createdBy==request.auth.uid && request.resource.data.createdAt==request.time;
   allow update,delete: if false;
  }
  // MC1101 V05: identificación por personal activo; revisión exclusiva de Calidad.
  // MC1102 V04 - expedientes de valoracion y seguimiento.
  match /sgcRiskAssessments/{id} {
   allow get, list: if manager();
   allow create: if manager()
     && request.resource.data.sourceId == id
     && exists(/databases/$(database)/documents/sgcRiskIdentifications/$(id))
     && get(/databases/$(database)/documents/sgcRiskIdentifications/$(id)).data.status == 'LINKED'
     && request.resource.data.createdBy == request.auth.uid
     && request.resource.data.updatedBy == request.auth.uid
     && request.resource.data.createdAt == request.time
     && request.resource.data.updatedAt == request.time
     && request.resource.data.kind in ['RIESGO','OPORTUNIDAD']
     && request.resource.data.history is list;
   allow update: if manager()
     && request.resource.data.sourceId == resource.data.sourceId
     && request.resource.data.kind == resource.data.kind
     && request.resource.data.createdAt == resource.data.createdAt
     && request.resource.data.createdBy == resource.data.createdBy
     && request.resource.data.updatedBy == request.auth.uid
     && request.resource.data.updatedAt == request.time
     && request.resource.data.history is list
     && request.resource.data.history.size() >= resource.data.history.size()
     && (resource.data.status != 'CERRADO' || request.resource.data.status == 'CERRADO')
     && (request.resource.data.status != 'CERRADO' || (
          request.resource.data.effectiveness.result == 'EFICAZ'
          && request.resource.data.effectiveness.evidence is string
          && request.resource.data.effectiveness.evidence.size() > 0
          && request.resource.data.closure.uid == request.auth.uid
          && ((resource.data.level != 'GRAVE' && resource.data.critical != true)
              || get(userPath()).data.role == 'ADMIN')));
   allow delete: if false;
  }
  match /sgcRiskIdentifications/{id}{
   allow get: if active() && (manager() || resource.data.createdBy == request.auth.uid);
   allow list: if active() && (manager() || resource.data.createdBy == request.auth.uid);
   allow create: if active()
    && request.resource.data.keys().hasOnly(['kind','source','process','description','cause','effect','controls','reference','formCode','formVersion','status','createdBy','createdByName','createdAt','updatedAt','reviewedBy','reviewedByName','reviewNote','reviewedAt','mc1102Id','identifiedYear','identifiedDate','identifiedBy','identifiedPersonId','identifiedPosition','identifiedArea','followUpOwner','followUpPersonId'])
    && request.resource.data.keys().hasAll(['kind','source','process','description','cause','effect','controls','reference','formCode','formVersion','status','createdBy','createdByName','createdAt','updatedAt','reviewedBy','reviewedByName','reviewNote','reviewedAt','mc1102Id','identifiedYear','identifiedDate','identifiedBy','identifiedPersonId','identifiedPosition','identifiedArea','followUpOwner','followUpPersonId'])
    && request.resource.data.kind in ['RIESGO','OPORTUNIDAD']
    && request.resource.data.status == 'PENDING'
    && request.resource.data.formCode == 'PSI-MC1101-05' && request.resource.data.formVersion == '05'
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
    && request.resource.data.reviewedBy == '' && request.resource.data.reviewedByName == '' && request.resource.data.reviewNote == '' && request.resource.data.reviewedAt == null && request.resource.data.mc1102Id == ''
    && request.resource.data.createdByName is string && request.resource.data.createdByName.size() <= 200
    && request.resource.data.source is string && request.resource.data.source.size() > 0 && request.resource.data.source.size() <= 120
    && request.resource.data.process is string && request.resource.data.process.size() > 0 && request.resource.data.process.size() <= 120
    && request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 1200
    && request.resource.data.cause is string && request.resource.data.cause.size() <= 800
    && request.resource.data.effect is string && request.resource.data.effect.size() <= 800
    && request.resource.data.controls is string && request.resource.data.controls.size() <= 800
    && request.resource.data.reference is string && request.resource.data.reference.size() <= 160;
   allow update: if manager() && resource.data.status == 'PENDING'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewNote','reviewedBy','reviewedByName','reviewedAt','updatedAt'])
    && request.resource.data.status in ['LINKED','NOT_LINKED','INFO_REQUIRED']
    && request.resource.data.reviewedBy == request.auth.uid
    && request.resource.data.reviewedByName is string && request.resource.data.reviewedByName.size() <= 200
    && request.resource.data.reviewNote is string && request.resource.data.reviewNote.size() <= 1000
    && (request.resource.data.status == 'LINKED' || request.resource.data.reviewNote.size() > 0)
    && request.resource.data.reviewedAt == request.time && request.resource.data.updatedAt == request.time;
   allow delete: if false;
  }
  // V1.0.91 · Evaluaciones 4.2.1 inmutables, consulta bajo demanda.
  match /sgcConfidentiality421/{id}{
   allow get,list: if manager();
   allow create: if manager() && request.resource.data.keys().hasOnly(['requirementId','checks','evidence','conclusion','createdBy','createdAt']) && request.resource.data.requirementId=='4.2.1' && request.resource.data.createdBy==request.auth.uid && request.resource.data.createdAt==request.time && request.resource.data.checks is map && request.resource.data.checks.keys().hasAll(['agreement','scope','notice','exceptions']) && request.resource.data.checks.keys().hasOnly(['agreement','scope','notice','exceptions']) && request.resource.data.checks.values().hasOnly(['PENDIENTE','VERIFICADO','ATENCION']) && request.resource.data.evidence is string && request.resource.data.evidence.size()>0 && request.resource.data.evidence.size()<=2000 && request.resource.data.conclusion is string && request.resource.data.conclusion.size()>0 && request.resource.data.conclusion.size()<=2000;
   allow update,delete: if false;
  }
  // V1.0.97 — 4.2.2: control simplificado + compatibilidad historica.
  match /sgcConfidentiality422/{id}{
   allow get,list: if manager();
   allow create: if manager()
    && request.resource.data.requirementId == '4.2.2'
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.createdAt == request.time
    && request.resource.data.evidence is string
    && request.resource.data.evidence.size() > 0
    && request.resource.data.evidence.size() <= 2000
    && request.resource.data.conclusion is string
    && request.resource.data.conclusion.size() > 0
    && request.resource.data.conclusion.size() <= 2000
    && (
      // V1.0.96: nombres exactos enviados por el formulario.
      (request.resource.data.keys().hasOnly(['requirementId','evaluationType','controlStatus','evidence','conclusion','createdBy','createdAt'])
       && request.resource.data.keys().hasAll(['requirementId','evaluationType','controlStatus','evidence','conclusion','createdBy','createdAt'])
       && request.resource.data.evaluationType == 'CONTROL_APLICACION'
       && request.resource.data.controlStatus in ['PENDIENTE','VERIFICADO','ATENCION','NO_APLICA'])
      ||
      // V1.0.95: formulario historico de cuatro criterios.
      (request.resource.data.keys().hasOnly(['requirementId','checks','evidence','conclusion','createdBy','createdAt'])
       && request.resource.data.keys().hasAll(['requirementId','checks','evidence','conclusion','createdBy','createdAt'])
       && request.resource.data.checks is map
       && request.resource.data.checks.keys().hasAll(['basis','scope','notice','exception'])
       && request.resource.data.checks.keys().hasOnly(['basis','scope','notice','exception'])
       && request.resource.data.checks.values().hasOnly(['PENDIENTE','VERIFICADO','ATENCION','NO_APLICA']))
    );
   allow update,delete: if false;
  }
  match /sgcConfidentiality422Disclosures/{id}{
   allow get,list: if manager();
   allow create: if manager() && request.resource.data.keys().hasOnly(['requirementId','date','client','recipient','information','basis','reference','notice','exception','status','createdBy','createdAt']) && request.resource.data.requirementId=='4.2.2' && request.resource.data.createdBy==request.auth.uid && request.resource.data.createdAt==request.time && request.resource.data.date is string && request.resource.data.date.size()==10 && request.resource.data.client is string && request.resource.data.client.size()>0 && request.resource.data.client.size()<=200 && request.resource.data.recipient is string && request.resource.data.recipient.size()>0 && request.resource.data.recipient.size()<=200 && request.resource.data.information is string && request.resource.data.information.size()>0 && request.resource.data.information.size()<=1000 && request.resource.data.basis in ['LEGAL','CONTRACTUAL'] && request.resource.data.reference is string && request.resource.data.reference.size()>0 && request.resource.data.reference.size()<=1000 && request.resource.data.notice in ['NOTIFICADA','PENDIENTE','PROHIBIDA'] && request.resource.data.exception is string && request.resource.data.exception.size()<=1000 && (request.resource.data.notice!='PROHIBIDA' || request.resource.data.exception.size()>0) && request.resource.data.status in ['REGISTRADA','REQUIERE_ATENCION'];
   allow update,delete: if false;
  }
  // V1.0.98 — 4.2.3: controles y casos inmutables; solo ADMIN/CALIDAD.
  match /sgcConfidentiality423/{id}{
   allow get,list: if manager();
   allow create: if manager()
    && request.resource.data.keys().hasOnly(['requirementId','evaluationType','controlStatus','evidence','conclusion','createdBy','createdAt'])
    && request.resource.data.keys().hasAll(['requirementId','evaluationType','controlStatus','evidence','conclusion','createdBy','createdAt'])
    && request.resource.data.requirementId=='4.2.3'
    && request.resource.data.evaluationType=='CONTROL_APLICACION'
    && request.resource.data.controlStatus in ['PENDIENTE','VERIFICADO','ATENCION','NO_APLICA']
    && request.resource.data.evidence is string && request.resource.data.evidence.size()>0 && request.resource.data.evidence.size()<=2000
    && request.resource.data.conclusion is string && request.resource.data.conclusion.size()>0 && request.resource.data.conclusion.size()<=2000
    && request.resource.data.createdBy==request.auth.uid && request.resource.data.createdAt==request.time;
   allow update,delete: if false;
  }
  match /sgcConfidentiality423Sources/{id}{
   allow get,list: if manager();
   allow create: if manager()
    && request.resource.data.keys().hasOnly(['requirementId','date','client','sourceType','description','protection','authorizationReference','evidence','status','createdBy','createdAt'])
    && request.resource.data.keys().hasAll(['requirementId','date','client','sourceType','description','protection','authorizationReference','evidence','status','createdBy','createdAt'])
    && request.resource.data.requirementId=='4.2.3'
    && request.resource.data.date is string && request.resource.data.date.size()==10
    && request.resource.data.client is string && request.resource.data.client.size()>0 && request.resource.data.client.size()<=200
    && request.resource.data.sourceType in ['AUTORIDAD','ORGANISMO','DENUNCIANTE','OTRO']
    && request.resource.data.description is string && request.resource.data.description.size()>0 && request.resource.data.description.size()<=1000
    && request.resource.data.protection in ['PROTEGIDA','REVELACION_AUTORIZADA']
    && request.resource.data.authorizationReference is string && request.resource.data.authorizationReference.size()<=500
    && (request.resource.data.protection!='REVELACION_AUTORIZADA' || request.resource.data.authorizationReference.size()>0)
    && request.resource.data.evidence is string && request.resource.data.evidence.size()>0 && request.resource.data.evidence.size()<=500
    && request.resource.data.status in ['REGISTRADO','REQUIERE_ATENCION','CERRADO']
    && request.resource.data.createdBy==request.auth.uid && request.resource.data.createdAt==request.time;
   allow update,delete: if false;
  }
  // V1.1.00 — Visitas externas: solo personal autorizado consulta y gestiona.
  // El registro público se realiza exclusivamente mediante Netlify Function.
  match /sgcExternalVisits/{id}{
   allow get,list: if manager();
   allow create,delete: if false;
   allow update: if manager()
    && resource.data.accepted == true
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','responsibleId','responsibleName','authorizerId','authorizerName','authorizedAt','reviewedBy','enteredAt','exitedAt','enteredBy','exitedBy','eventNote','historicalRecord','historicalAuthorizationDocumented','historicalRecordedAt','historicalRecordedBy','identityConfirmation','identityConfirmedAt','identityConfirmedBy'])
    && ((resource.data.status == 'PENDIENTE' && request.resource.data.status in ['AUTORIZADA','EN_INSTALACIONES']
         && request.resource.data.responsibleId is string && request.resource.data.responsibleId.size()>0
         && request.resource.data.responsibleName is string && request.resource.data.responsibleName.size()>0
         && request.resource.data.authorizerId is string && request.resource.data.authorizerId.size()>0
         && request.resource.data.authorizerName is string && request.resource.data.authorizerName.size()>0
         && request.resource.data.identityConfirmation == 'CEDULA_COINCIDENTE'
         && request.resource.data.identityConfirmedAt == request.time
         && request.resource.data.identityConfirmedBy == request.auth.uid
         && request.resource.data.reviewedBy == request.auth.uid
         && ((request.resource.data.get('historicalRecord',false) == true
             && request.resource.data.historicalRecordedAt == request.time
             && request.resource.data.historicalRecordedBy == request.auth.uid
             && request.resource.data.get('eventNote','') is string
             && request.resource.data.eventNote.size()>0
             && ((request.resource.data.historicalAuthorizationDocumented == true
                 && request.resource.data.authorizedAt is timestamp
                 && request.resource.data.authorizedAt <= request.time)
                || (request.resource.data.historicalAuthorizationDocumented == false
                    && request.resource.data.authorizedAt == null)))
            || (request.resource.data.get('historicalRecord',false) == false
                && request.resource.data.authorizedAt == request.time))
         && (request.resource.data.status == 'AUTORIZADA'
             || (request.resource.data.enteredAt is timestamp
                 && request.resource.data.enteredAt <= request.time
                 && request.resource.data.enteredBy == request.auth.uid
                 && (request.resource.data.get('historicalRecord',false) == true
                     || request.resource.data.enteredAt >= request.time - duration.value(5,'m')))))
       || (resource.data.status == 'PENDIENTE' && request.resource.data.status == 'NO_AUTORIZADA'
           && request.resource.data.reviewedBy == request.auth.uid)
       || (resource.data.status == 'AUTORIZADA' && request.resource.data.status == 'EN_INSTALACIONES'
           && request.resource.data.enteredAt is timestamp
           && request.resource.data.enteredAt <= request.time
           && request.resource.data.enteredBy == request.auth.uid
           && (request.resource.data.enteredAt >= resource.data.authorizedAt
               || (request.resource.data.get('historicalRecord',false) == true
                   && request.resource.data.historicalRecordedAt == request.time
                   && request.resource.data.historicalRecordedBy == request.auth.uid
                   && request.resource.data.get('eventNote','') is string
                   && request.resource.data.eventNote.size()>0)
               || resource.data.get('historicalRecord',false) == true))
       || (resource.data.status == 'EN_INSTALACIONES' && request.resource.data.status == 'FINALIZADA'
           && request.resource.data.exitedAt is timestamp
           && request.resource.data.exitedAt <= request.time
           && request.resource.data.exitedAt >= resource.data.enteredAt
           && request.resource.data.exitedBy == request.auth.uid));
  }
  match /sgcRecords/{id}{allow get,list:if active();allow create:if manager() && allowedRecord();allow update,delete:if false;}
  // V1.0.37 — Firma presencial: PIN y verificaciones exclusivamente del servidor.
  match /sgcSignatureCredentials/{id}{
   allow read,write: if false;
  }
  // Constancias inmutables para el cliente; escritura exclusiva del servicio Netlify.
  match /sgcSignatureRecords/{id}{
   allow get,list: if manager();
   allow create,update,delete: if false;
  }
  match /{document=**}{allow read,write:if false;}
 }
}
