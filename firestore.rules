rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function profile(){return get(/databases/$(database)/documents/users/$(request.auth.uid));}
  function active(){return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile().data.status == 'ACTIVO';}
  function boss(){return active() && profile().data.role == 'JEFE';}
  match /users/{uid} {
   allow get: if signedIn() && (request.auth.uid == uid || boss());
   allow list: if boss();
   allow create, update, delete: if false;
   match /notifications/{id} {
    allow read: if active() && (request.auth.uid == uid || boss());
    allow write: if false;
   }
  }
  // V29.0.75: expediente de conversación. Solo JEFE y analista asignado.
  // V29.0.79: cada usuario solo puede consultar y modificar sus propias lecturas.
  match /communicationReads/{uid}/plans/{planId} {
   function assigned(){return exists(/databases/$(database)/documents/plannerAssignments/$(planId)) && (boss() || get(/databases/$(database)/documents/plannerAssignments/$(planId)).data.analystId==uid);}
   allow read: if active() && request.auth.uid==uid;
   allow create,update: if active() && request.auth.uid==uid && assigned()
    && request.resource.data.keys().hasOnly(['messageId','updatedAt','archived','assignmentSeen'])
    && (!('messageId' in request.resource.data) || (request.resource.data.messageId is string && request.resource.data.messageId.size()>0 && request.resource.data.messageId.size()<=160))
    && (!('archived' in request.resource.data) || request.resource.data.archived is bool)
    && (!('assignmentSeen' in request.resource.data) || request.resource.data.assignmentSeen is int)
    && request.resource.data.updatedAt==request.time;
   allow delete: if false;
  }
  match /activityCommunications/{planId} {
   function planPath(){return /databases/$(database)/documents/plannerAssignments/$(planId);}
   function participant(){return active() && exists(planPath()) && (boss() || get(planPath()).data.analystId == request.auth.uid);}
   allow get: if participant();
   allow list, delete: if false;
   allow create: if boss() && exists(planPath())
    && request.resource.data.keys().hasOnly(['status','updatedBy','updatedAt','revision'])
    && request.resource.data.status in ['ATENCION','SEGUIMIENTO','ATENDIDO']
    && request.resource.data.updatedBy==request.auth.uid && request.resource.data.updatedAt==request.time
    && request.resource.data.revision==1;
   allow update: if boss() && exists(planPath())
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedBy','updatedAt','revision'])
    && request.resource.data.status in ['ATENCION','SEGUIMIENTO','ATENDIDO']
    && request.resource.data.updatedBy==request.auth.uid && request.resource.data.updatedAt==request.time
    && request.resource.data.revision==resource.data.revision+1;
   match /messages/{messageId} {
    allow read: if participant();
    allow create: if participant()
     && request.resource.data.keys().hasOnly(['planId','body','authorId','authorName','createdAt'])
     && request.resource.data.planId==planId
     && request.resource.data.authorId==request.auth.uid
     && request.resource.data.body is string && request.resource.data.body.size()>0 && request.resource.data.body.size()<=1500
     && request.resource.data.authorName is string && request.resource.data.authorName.size()<=100
     && request.resource.data.createdAt==request.time;
    allow update, delete: if false;
   }
  }
  // V29.0.90: incidencias por actividad, clasificación exclusiva del JEFE.
  match /activityTechnicalAlerts/{planId}/items/{alertId} {
   function planPath(){return /databases/$(database)/documents/plannerAssignments/$(planId);}
   function participant(){return active() && exists(planPath()) && (boss() || get(planPath()).data.analystId==request.auth.uid);}
   allow read: if participant();
   allow create: if participant()
    && request.resource.data.keys().hasOnly(['planId','description','authorId','authorName','severity','status','createdAt','updatedAt','updatedBy','revision','history'])
    && request.resource.data.planId==planId && request.resource.data.authorId==request.auth.uid
    && request.resource.data.updatedBy==request.auth.uid
    && request.resource.data.description is string && request.resource.data.description.size()>=5 && request.resource.data.description.size()<=1200
    && request.resource.data.authorName is string && request.resource.data.authorName.size()<=100
    && request.resource.data.severity=='INFORMATIVA' && request.resource.data.status=='ABIERTA'
    && request.resource.data.createdAt==request.time && request.resource.data.updatedAt==request.time
    && request.resource.data.revision==1 && request.resource.data.history is list && request.resource.data.history.size()==1;
   allow update: if boss() && exists(planPath())
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['severity','status','updatedAt','updatedBy','revision','history'])
    && request.resource.data.severity in ['INFORMATIVA','REVISION','CRITICA']
    && request.resource.data.status in ['ABIERTA','EN_SEGUIMIENTO','RESUELTA']
    && request.resource.data.updatedAt==request.time && request.resource.data.updatedBy==request.auth.uid
    && request.resource.data.revision==resource.data.revision+1
    && request.resource.data.history is list && request.resource.data.history.size()==resource.data.history.size()+1
    && request.resource.data.history.size()<=40;
   allow delete: if false;
  }
  // Contadores de códigos técnicos por categoría; uso exclusivo del JEFE.
  match /catalogCounters/{prefix} {
   allow get: if boss();
   allow list, delete: if false;
   allow create: if boss() && request.resource.data.keys().hasOnly(['last']) && request.resource.data.last is int && request.resource.data.last > 0;
   allow update: if boss() && request.resource.data.keys().hasOnly(['last']) && request.resource.data.last is int && request.resource.data.last > resource.data.last;
  }
  // V29.0.46: cartas maestras, creadas exclusivamente por JEFE.
  match /controlCards/{id} {
    allow read: if active();
    allow create: if boss()
      && request.resource.data.keys().hasOnly(['name','code','activityIds','status','frequency','min','max','unit','kind','equipment','tolerance','createdBy','createdAt'])
      && request.resource.data.name is string && request.resource.data.name.size()>0
      && request.resource.data.code is string && request.resource.data.code.size()>0
      && request.resource.data.activityIds is list && request.resource.data.activityIds.size()>0 && request.resource.data.activityIds.size()<=100
      && request.resource.data.min is number && request.resource.data.max is number
      && request.resource.data.min<request.resource.data.max
      && request.resource.data.kind in ['SIMPLE','MULTIPUNTO','CONDUCTIVIDAD']
      && request.resource.data.equipment is string
      && (request.resource.data.tolerance==null || (request.resource.data.tolerance is number && request.resource.data.tolerance>0))
      && request.resource.data.status=='ACTIVO' && request.resource.data.frequency=='DIARIA'
      && request.resource.data.createdBy==request.auth.uid && request.resource.data.createdAt==request.time;
    // Solo JEFE corrige identificación; no altera límites, vínculos ni registros diarios.
    allow update: if boss()
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','code','equipment','identityRevision','identityUpdatedBy','identityUpdatedAt','identityReason'])
      && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=160
      && request.resource.data.code is string && request.resource.data.code.size()>0 && request.resource.data.code.size()<=80
      && request.resource.data.equipment is string && request.resource.data.equipment.size()>0 && request.resource.data.equipment.size()<=160
      && request.resource.data.identityRevision==resource.data.get('identityRevision',0)+1
      && request.resource.data.identityUpdatedBy==request.auth.uid
      && request.resource.data.identityUpdatedAt==request.time
      && request.resource.data.identityReason is string && request.resource.data.identityReason.size()>=8 && request.resource.data.identityReason.size()<=500;
    // Solo JEFE cambia asignaciones, sin alterar identidad, límites o historial.
    allow update: if boss()
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','activityIds','linksUpdatedBy','linksUpdatedAt'])
      && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=160
      && request.resource.data.activityIds is list
      && request.resource.data.activityIds.size()>0 && request.resource.data.activityIds.size()<=100
      && request.resource.data.linksUpdatedBy==request.auth.uid
      && request.resource.data.linksUpdatedAt==request.time;
    allow delete: if false;
  }
  match /controlCardIdentityHistory/{auditId} {
    allow read: if boss();
    allow create: if boss()
      && request.resource.data.keys().hasOnly(['cardId','revision','before','after','reason','updatedBy','updatedAt'])
      && request.resource.data.cardId is string
      && request.resource.data.updatedBy==request.auth.uid
      && request.resource.data.updatedAt==request.time
      && request.resource.data.reason is string && request.resource.data.reason.size()>=8
      && request.resource.data.before is map && request.resource.data.after is map
      && getAfter(/databases/$(database)/documents/controlCards/$(request.resource.data.cardId)).data.identityRevision==request.resource.data.revision
      && getAfter(/databases/$(database)/documents/controlCards/$(request.resource.data.cardId)).data.code==request.resource.data.after.code;
    allow update, delete: if false;
  }
  // Históricos físicos: solo JEFE, inmutables y separados de cumplimiento diario.
  match /manualControlHistory/{recordId} {
    allow read: if active();
    allow create: if boss()
      && request.resource.data.keys().hasOnly(['date','controlId','kind','origin','status','readings','nominals','tolerance','conforms','responsibleUid','responsibleName','source','observations','digitizedBy','digitizedAt'])
      && recordId==request.resource.data.date+'_'+request.resource.data.controlId
      && request.resource.data.date is string && request.resource.data.date.size()==10
      && exists(/databases/$(database)/documents/controlCards/$(request.resource.data.controlId))
      && !exists(/databases/$(database)/documents/dailyControlRecords/$(recordId))
      && request.resource.data.kind=='MULTIPUNTO'
      && request.resource.data.origin=='HISTORICO_MANUAL'
      && request.resource.data.nominals==[4,7,10]
      && request.resource.data.readings is list && request.resource.data.readings.size()==3
      && request.resource.data.readings[0] is number && request.resource.data.readings[1] is number && request.resource.data.readings[2] is number
      && request.resource.data.readings[0]>=0 && request.resource.data.readings[0]<=14
      && request.resource.data.readings[1]>=0 && request.resource.data.readings[1]<=14
      && request.resource.data.readings[2]>=0 && request.resource.data.readings[2]<=14
      && request.resource.data.tolerance==get(/databases/$(database)/documents/controlCards/$(request.resource.data.controlId)).data.tolerance
      && request.resource.data.conforms == ((request.resource.data.readings[0]-4<=request.resource.data.tolerance && 4-request.resource.data.readings[0]<=request.resource.data.tolerance) && (request.resource.data.readings[1]-7<=request.resource.data.tolerance && 7-request.resource.data.readings[1]<=request.resource.data.tolerance) && (request.resource.data.readings[2]-10<=request.resource.data.tolerance && 10-request.resource.data.readings[2]<=request.resource.data.tolerance))
      && request.resource.data.status==(request.resource.data.conforms?'COMPLETADA':'NO_CONFORME')
      && request.resource.data.responsibleUid is string
      && exists(/databases/$(database)/documents/users/$(request.resource.data.responsibleUid))
      && request.resource.data.responsibleName==get(/databases/$(database)/documents/users/$(request.resource.data.responsibleUid)).data.name
      && request.resource.data.source is string && request.resource.data.source.size()>=3 && request.resource.data.source.size()<=200
      && request.resource.data.observations is string && request.resource.data.observations.size()<=1000
      && request.resource.data.digitizedBy==request.auth.uid && request.resource.data.digitizedAt==request.time;
    allow update, delete: if false;
  }
  // V29.0.199: bloqueo documental cruzado por fecha e identidad estable.
  function historicalArchiveFree(date, cardId) {
    return !exists(/databases/$(database)/documents/historicalControlArchive/$(date+'_id-'+cardId));
  }
  // V29.0.212: contrato común para registros operativos especializados.
  // Conserva identidad fecha+carta, autor autenticado, sello de servidor e inmutabilidad.
  function specialCore(recordId) {
    let d = request.resource.data;
    return active()
      && d.keys().hasAll(['cardId','date','month','time','completedBy','completedAt','conforms','status','responsibleName','observations'])
      && d.cardId is string && d.cardId.size() > 0 && d.cardId.size() <= 120
      && d.date is string && d.date.size() == 10
      && recordId == d.date + '_' + d.cardId
      && d.date.matches('^' + d.month + '-[0-9]{2}$')
      && d.time is string && d.time.size() == 5
      && d.completedBy == request.auth.uid && d.completedAt == request.time
      && d.responsibleName is string && d.responsibleName.size() > 0 && d.responsibleName.size() <= 200
      && d.observations is string && d.observations.size() <= 1500
      && d.conforms is bool
      && d.status == (d.conforms ? 'COMPLETADA' : 'NO_CONFORME')
      && historicalArchiveFree(d.date,d.cardId);
  }
  function closeNumber(a,b) {
    return a is number && b is number && a-b <= 0.000001 && b-a <= 0.000001;
  }
  // Un único documento por día y carta, incluso con dos analistas simultáneos.
  match /dailyControlRecords/{recordId} {
    allow read: if active();
    allow create: if active()
      && historicalArchiveFree(request.resource.data.date, request.resource.data.controlId)
      && request.resource.data.keys().hasOnly(['date','controlId','status','value','unit','min','max','completedBy','completedAt'])
      && recordId==request.resource.data.date+'_'+request.resource.data.controlId
      && request.resource.data.date is string && request.resource.data.date.size()==10
      && request.resource.data.controlId is string
      && request.resource.data.completedBy==request.auth.uid
      && request.resource.data.completedAt==request.time
      && request.resource.data.status=='COMPLETADA'
      && request.resource.data.value is number
      && exists(/databases/$(database)/documents/controlCards/$(request.resource.data.controlId))
      && get(/databases/$(database)/documents/controlCards/$(request.resource.data.controlId)).data.status=='ACTIVO'
      && request.resource.data.min==get(/databases/$(database)/documents/controlCards/$(request.resource.data.controlId)).data.min
      && request.resource.data.max==get(/databases/$(database)/documents/controlCards/$(request.resource.data.controlId)).data.max
      && request.resource.data.unit==get(/databases/$(database)/documents/controlCards/$(request.resource.data.controlId)).data.unit
      && request.resource.data.value>=request.resource.data.min
      && request.resource.data.value<=request.resource.data.max;
    // V29.0.98: registro multipunto con tres niveles, validación y evidencia no conforme.
    allow create: if active()
      && historicalArchiveFree(request.resource.data.date, request.resource.data.controlId)
      && request.resource.data.keys().hasOnly(['date','controlId','kind','status','readings','errors','nominals','tolerance','conforms','observations','completedBy','completedAt'])
      && recordId==request.resource.data.date+'_'+request.resource.data.controlId
      && request.resource.data.date is string && request.resource.data.date.size()==10
      && request.resource.data.completedBy==request.auth.uid
      && request.resource.data.completedAt==request.time
      && request.resource.data.kind=='MULTIPUNTO'
      && request.resource.data.readings is list && request.resource.data.readings.size()==3
      && request.resource.data.nominals==[4,7,10]
      && request.resource.data.errors is list && request.resource.data.errors.size()==3
      && request.resource.data.readings[0] is number && request.resource.data.readings[1] is number && request.resource.data.readings[2] is number
      && request.resource.data.readings[0]>=0 && request.resource.data.readings[0]<=14
      && request.resource.data.readings[1]>=0 && request.resource.data.readings[1]<=14
      && request.resource.data.readings[2]>=0 && request.resource.data.readings[2]<=14
      && request.resource.data.errors[0] == request.resource.data.readings[0]-4
      && request.resource.data.errors[1] == request.resource.data.readings[1]-7
      && request.resource.data.errors[2] == request.resource.data.readings[2]-10
      && request.resource.data.observations is string && request.resource.data.observations.size()<=1500
      && exists(/databases/$(database)/documents/controlCards/$(request.resource.data.controlId))
      && get(/databases/$(database)/documents/controlCards/$(request.resource.data.controlId)).data.kind=='MULTIPUNTO'
      && get(/databases/$(database)/documents/controlCards/$(request.resource.data.controlId)).data.status=='ACTIVO'
      && request.resource.data.tolerance==get(/databases/$(database)/documents/controlCards/$(request.resource.data.controlId)).data.tolerance
      && request.resource.data.conforms == (request.resource.data.errors[0]<=request.resource.data.tolerance && request.resource.data.errors[0]>=-request.resource.data.tolerance && request.resource.data.errors[1]<=request.resource.data.tolerance && request.resource.data.errors[1]>=-request.resource.data.tolerance && request.resource.data.errors[2]<=request.resource.data.tolerance && request.resource.data.errors[2]>=-request.resource.data.tolerance)
      && request.resource.data.status==(request.resource.data.conforms?'COMPLETADA':'NO_CONFORME');
    // PEC0404-05: registro diario inmutable, 3 niveles, error relativo ≤5%.
    allow create: if active()
      && historicalArchiveFree(request.resource.data.date, request.resource.data.controlId)
      && request.resource.data.keys().hasOnly(['date','controlId','kind','status','readings','errors','relativeErrors','nominals','tolerance','conforms','observations','completedBy','completedAt'])
      && recordId==request.resource.data.date+'_'+request.resource.data.controlId
      && request.resource.data.date is string && request.resource.data.date.size()==10
      && request.resource.data.completedBy==request.auth.uid && request.resource.data.completedAt==request.time
      && request.resource.data.kind=='CONDUCTIVIDAD'
      && request.resource.data.nominals==[84,1413,12.88]
      && request.resource.data.readings is list && request.resource.data.readings.size()==3
      && request.resource.data.errors is list && request.resource.data.errors.size()==3
      && request.resource.data.relativeErrors is list && request.resource.data.relativeErrors.size()==3
      && request.resource.data.readings[0] is number && request.resource.data.readings[0]>=0
      && request.resource.data.readings[1] is number && request.resource.data.readings[1]>=0
      && request.resource.data.readings[2] is number && request.resource.data.readings[2]>=0
      && request.resource.data.errors[0]==request.resource.data.readings[0]-84
      && request.resource.data.errors[1]==request.resource.data.readings[1]-1413
      && request.resource.data.errors[2]==request.resource.data.readings[2]-12.88
      // Firestore Rules no admite división ni multiplicación.
      // Los porcentajes son informativos; la conformidad se verifica
      // directamente contra las lecturas y los límites técnicos del ±5%.
      && request.resource.data.relativeErrors[0] is number
      && request.resource.data.relativeErrors[1] is number
      && request.resource.data.relativeErrors[2] is number
      && request.resource.data.relativeErrors[0]>=0
      && request.resource.data.relativeErrors[1]>=0
      && request.resource.data.relativeErrors[2]>=0
      && request.resource.data.observations is string && request.resource.data.observations.size()<=1500
      && exists(/databases/$(database)/documents/controlCards/$(request.resource.data.controlId))
      && get(/databases/$(database)/documents/controlCards/$(request.resource.data.controlId)).data.kind=='CONDUCTIVIDAD'
      && get(/databases/$(database)/documents/controlCards/$(request.resource.data.controlId)).data.code=='PEC0404-05'
      && get(/databases/$(database)/documents/controlCards/$(request.resource.data.controlId)).data.status=='ACTIVO'
      && request.resource.data.tolerance==5
      && get(/databases/$(database)/documents/controlCards/$(request.resource.data.controlId)).data.tolerance==5
      && request.resource.data.conforms==(
        request.resource.data.readings[0]>=79.8 && request.resource.data.readings[0]<=88.2
        && request.resource.data.readings[1]>=1342.35 && request.resource.data.readings[1]<=1483.65
        && request.resource.data.readings[2]>=12.236 && request.resource.data.readings[2]<=13.524
      )
      && request.resource.data.status==(request.resource.data.conforms?'COMPLETADA':'NO_CONFORME');
    allow update,delete: if false;
  }

  // V29.0.25: fichas y versiones históricas; se conserva createdAt mediante merge.
  match /catalog/{id} {
    allow read: if active();
    allow create: if boss()
      && request.resource.data.updatedBy == request.auth.uid
      && request.resource.data.revision == 1
      && request.resource.data.technicalVersion == 1
      && request.resource.data.durationMin is number
      && request.resource.data.durationMin > 0;
    // Compatibilidad con fichas anteriores a la introducción de technicalVersion.
    // Se protegen el identificador, la creación y la secuencia de revisiones.
    allow update: if boss()
      && request.resource.data.updatedBy == request.auth.uid
      && request.resource.data.revision is int
      && request.resource.data.revision == resource.data.get('revision',0) + 1
      && request.resource.data.technicalVersion is int
      && request.resource.data.technicalVersion == resource.data.get('technicalVersion',1) + 1
      && request.resource.data.durationMin is number
      && request.resource.data.durationMin > 0
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name','code','method','instructions','curveType','curvePoints','curveUnit',
        'curveStandards','timeModel','timeRanges','components','sampleParameters',
        'technicalVersion','area','durationMin','type','requiresSamples',
        'requiresCurve','reactives','active','revision','updatedAt','updatedBy',
        'controlIds'
      ]);
    allow delete: if false;
    match /versions/{versionId} {
      allow get, list: if boss();
      allow create: if boss()
        && request.resource.data.keys().hasOnly(['snapshot','archivedAt','archivedBy','version'])
        && request.resource.data.keys().hasAll(['snapshot','archivedAt','archivedBy','version'])
        && request.resource.data.archivedBy == request.auth.uid
        && request.resource.data.archivedAt == request.time
        && request.resource.data.snapshot is map
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.snapshot.get('technicalVersion',1) == request.resource.data.version
        && request.resource.data.snapshot == get(/databases/$(database)/documents/catalog/$(id)).data;
      allow update, delete: if false;
    }
  }

  // Registro único por tipo + nombre normalizado. El contador solo se modifica
  // mediante transacción. La aplicación nunca debe usar estos datos como
  // sustituto de un backend privilegiado para autorizaciones adicionales.
  match /productRegistry/{key} {
    allow get: if boss();
    allow list, update, delete: if false;
    allow create: if boss() && request.resource.data.keys().hasAll(['code','name','productType','createdAt','createdBy'])
      && request.resource.data.createdBy==request.auth.uid
      && request.resource.data.createdAt==request.time
      && request.resource.data.productType in ['REACTIVO','ESTANDAR','MRC','INSUMO'];
  }
  match /productCounters/{type} {
    allow get: if boss();
    allow list, delete: if false;
    allow create: if boss() && type in ['REACTIVO','ESTANDAR','MRC','INSUMO']
      && request.resource.data.keys().hasOnly(['last']) && request.resource.data.last==1;
    allow update: if boss() && type in ['REACTIVO','ESTANDAR','MRC','INSUMO']
      && request.resource.data.keys().hasOnly(['last'])
      && request.resource.data.last==resource.data.last+1;
  }

  // V29.0.43: el movimiento de analista requiere actividad abierta y asiento vinculado.
  function journeyEntry(op){return getAfter(/databases/$(database)/documents/journeyConsumptions/$(op));}
  function journeyOwner(op){return active() && profile().data.role=='ANALISTA'
   && journeyEntry(op).data.uid==request.auth.uid
   && get(/databases/$(database)/documents/plannerAssignments/$(journeyEntry(op).data.planId)).data.analystId==request.auth.uid
   && get(/databases/$(database)/documents/plannerAssignments/$(journeyEntry(op).data.planId)).data.status=='EN_PROCESO';}
  // Expedientes MRC: registros documentales separados del inventario.
  match /referenceDossiers/{id} {
    allow read: if active();
    allow create: if active() && request.resource.data.updatedBy == request.auth.uid
      && request.resource.data.origin in ['INVENTARIO','MANUAL']
      && (request.resource.data.origin == 'INVENTARIO' || boss())
      && (request.resource.data.reviewStatus != 'APROBADO' || boss());
    allow update: if active() && request.resource.data.updatedBy == request.auth.uid
      && request.resource.data.origin == resource.data.origin
