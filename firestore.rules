      && historicalArchiveFree(request.resource.data.date, request.resource.data.cardId)
      && request.resource.data.keys().hasOnly(['cardId','equipment','date','month','time','reading','conforms','status','unit','min','max','observations','completedBy','responsibleName','completedAt'])
      && request.resource.data.cardId=='DIST-EI329-RES' && request.resource.data.equipment=='EI-329'
      && request.resource.data.date is string && request.resource.data.date.size()==10
      && recordId==request.resource.data.date+'_DIST-EI329-RES'
      && request.resource.data.date.matches('^' + request.resource.data.month + '-[0-9]{2}$')
      && request.resource.data.time is string && request.resource.data.time.size()==5
      && request.resource.data.reading is number && request.resource.data.reading>=0 && request.resource.data.reading<=100
      && request.resource.data.unit=='MΩ·cm' && request.resource.data.min==15 && request.resource.data.max==20
      && request.resource.data.conforms==(request.resource.data.reading>=15 && request.resource.data.reading<=20)
      && request.resource.data.status==(request.resource.data.conforms?'COMPLETADA':'NO_CONFORME')
      && request.resource.data.observations is string && request.resource.data.observations.size()<=1500
      && request.resource.data.responsibleName is string && request.resource.data.responsibleName.size()<=200
      && request.resource.data.completedBy==request.auth.uid && request.resource.data.completedAt==request.time;
    allow create: if specialCore(recordId)
      && request.resource.data.cardId == 'DIST-EI329-RES'
      && request.resource.data.keys().hasOnly(['cardId','equipment','date','month','time','reading','conforms','status','unit','min','max','observations','completedBy','responsibleName','completedAt'])
      && request.resource.data.reading is number && request.resource.data.reading >= 0 && request.resource.data.reading <= 100
      && request.resource.data.unit == 'MΩ·cm'
      && request.resource.data.min == 15 && request.resource.data.max == 20
      && request.resource.data.conforms == (request.resource.data.reading>=15 && request.resource.data.reading<=20);
    allow update,delete: if false;
  }
  // V29.0.195: archivo documental histórico; inmutable y solo JEFE escribe.
  match /historicalControlArchive/{recordId} {
    allow read: if active();
    // Archivo inmutable; validación del documento y su identidad canónica.
    // La conformidad técnica histórica requiere cotejo documental por el JEFE.
    allow create: if boss()
      && request.resource.data.keys().hasOnly(['date','cardId','cardKey','cardName','family','origin','readings','corrected','correction','corrections','correctionBasis','certificate','criterion','conforms','status','responsibleName','source','observations','digitizedBy','digitizedAt'])
      && request.resource.data.keys().hasAll(['date','cardId','cardKey','cardName','family','origin','readings','corrected','correction','corrections','correctionBasis','certificate','criterion','conforms','status','responsibleName','source','observations','digitizedBy','digitizedAt'])
      && request.resource.data.origin=='HISTORICO_MANUAL'
      && request.resource.data.date is string && request.resource.data.date.size()==10
      && request.resource.data.cardId is string && request.resource.data.cardId.size()>0 && request.resource.data.cardId.size()<=100
      && request.resource.data.cardKey=='id-'+request.resource.data.cardId
      && recordId==request.resource.data.date+'_'+request.resource.data.cardKey
      && request.resource.data.cardName is string && request.resource.data.cardName.size()>0 && request.resource.data.cardName.size()<=180
      && request.resource.data.family in ['PH','CONDUCTIVIDAD','BALANZA','AMBIENTAL','TERMICO','PATRON','TEMPERATURA','RESISTIVIDAD','GENERAL']
      && request.resource.data.readings is list && request.resource.data.readings.size()>=1 && request.resource.data.readings.size()<=3
      && request.resource.data.corrected is list && request.resource.data.corrected.size()==request.resource.data.readings.size()
      && request.resource.data.correction is number && request.resource.data.correction>=-30 && request.resource.data.correction<=30
      && request.resource.data.corrections is list && request.resource.data.corrections.size()==request.resource.data.readings.size()
      && request.resource.data.correctionBasis in ['PATRON','EQUIPO','NINGUNA']
      && request.resource.data.certificate is string && request.resource.data.certificate.size()>=5 && request.resource.data.certificate.size()<=200
      && request.resource.data.criterion is string && request.resource.data.criterion.size()>=5 && request.resource.data.criterion.size()<=200
      && request.resource.data.conforms is bool
      && request.resource.data.status==(request.resource.data.conforms?'COMPLETADA':'NO_CONFORME')
      && request.resource.data.responsibleName is string && request.resource.data.responsibleName.size()>0 && request.resource.data.responsibleName.size()<=160
      && request.resource.data.source is string && request.resource.data.source.size()>=3 && request.resource.data.source.size()<=200
      && request.resource.data.observations is string && request.resource.data.observations.size()<=1500
      && request.resource.data.digitizedBy==request.auth.uid && request.resource.data.digitizedAt==request.time
      && !exists(/databases/$(database)/documents/dailyControlRecords/$(request.resource.data.date+'_'+request.resource.data.cardId));
    allow update, delete: if false;
  }
  // SETED V2: analistas activos consultan existencias y registran pesajes; gestión exclusiva JEFE.
  match /setedBottles/{id} {
   allow read: if active();
   allow create: if boss() && request.resource.data.createdBy==request.auth.uid && request.resource.data.revision==1 && request.resource.data.quantity is number && request.resource.data.quantity>=0;
   allow update: if active() && (boss() || (profile().data.role == 'ANALISTA' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastGross','quantity','revision','updatedAt','updatedBy']) && request.resource.data.lastGross is number && request.resource.data.lastGross <= resource.data.lastGross && request.resource.data.quantity <= resource.data.quantity && resource.data.density is number && resource.data.density > 0 && (request.resource.data.quantity - (resource.data.quantity - (resource.data.lastGross - request.resource.data.lastGross) / resource.data.density)) < 0.0001 && (request.resource.data.quantity - (resource.data.quantity - (resource.data.lastGross - request.resource.data.lastGross) / resource.data.density)) > -0.0001)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastGross','quantity','revision','updatedAt','updatedBy','lot','tare','density','initialGross','officialOpening','openingDate','invoice','entryResponsible','entryResponsibleId','entryType','correctionHistory']) && request.resource.data.revision==resource.data.revision+1 && request.resource.data.updatedBy==request.auth.uid && request.resource.data.quantity>=0;
   allow delete: if false;
  }
  match /setedCorrections/{id} {
   allow read: if boss();
   allow create: if boss() && request.resource.data.correctedBy==request.auth.uid && request.resource.data.movementId==id && request.resource.data.history.size()==1;
   allow update: if boss() && request.resource.data.correctedBy==request.auth.uid && request.resource.data.movementId==resource.data.movementId && request.resource.data.originalDate==resource.data.originalDate && request.resource.data.history.size()==resource.data.history.size()+1;
   allow delete: if false;
  }
  match /setedMovements/{id} {
   allow read: if active();
   allow create: if active() && (boss() || profile().data.role == 'ANALISTA') && request.resource.data.createdBy==request.auth.uid && request.resource.data.type=='CONSUMO_PESAJE';
   allow update,delete: if false;
  }
  match /{document=**} {allow read,write:if false;}
 }
}
